# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
# Generate secrets with: openssl rand -base64 48

# Public domain pointing at the VPS (DNS A record). Used for Caddy TLS,
# signed stream origins, and the public-host media gate.
SPICE_DOMAIN=music.example.com

# Postgres (local container; ditch-Neon replacement).
POSTGRES_USER=spice
POSTGRES_PASSWORD=change_me_long_alphanumeric_no_url_reserved_chars
POSTGRES_DB=spice

# App secrets (all required except the media token).
JWT_SECRET=change_me
SPICE_STREAM_HMAC_SECRET=change_me

# Optional bearer token for non-browser media access (desktop app, CLI,
# curl). Browsers on the site pass via same-origin checks instead.
SPICE_SELFHOST_MEDIA_TOKEN=
