# UI-lab staging env (VPS: ~/spice/ui-lab/deploy/.env.lab). NOT committed with
# values — copy this file to .env.lab and fill it in on the box.
#
# Fresh per box (generate with `openssl rand -base64 48`):
#   POSTGRES_PASSWORD must stay alphanumeric (it is interpolated into
#   DATABASE_URL, so URL-reserved chars break the connection string).
# Reused from prod ~/spice/deploy/.env so the lab behaves like prod:
#   TMDB_API_KEY, SOUNDCLOUD_CLIENT_ID, LASTFM_*, RESEND_API_KEY,
#   SPICE_EMAIL_FROM, EMAIL_VERIFICATION_SECRET, SPICE_ADMIN_EMAILS,
#   SPICE_MOVIE_PROVIDER_BASE_URL, SPICE_CORS_ORIGINS.

POSTGRES_USER=spice_lab
POSTGRES_PASSWORD=CHANGE_ME_ALPHANUMERIC
POSTGRES_DB=spice_lab

JWT_SECRET=CHANGE_ME
SPICE_STREAM_HMAC_SECRET=CHANGE_ME
SPICE_SELFHOST_MEDIA_TOKEN=
SPICE_LAB_DOMAIN=lab.spice-app.xyz
SPICE_APEX_DOMAIN=spice-app.xyz
SPICE_MOVIE_DOMAIN=movie.spice-app.xyz
RESEND_API_KEY=
SPICE_EMAIL_FROM=
EMAIL_VERIFICATION_SECRET=
SPICE_ADMIN_EMAILS=
SPICE_PAIRING_SECRET=CHANGE_ME
PROFILE_CONNECTION_SECRET=CHANGE_ME
SOUNDCLOUD_CLIENT_ID=
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_SHARED_SECRET=
SPICE_CORS_ORIGINS=
SPICE_MOVIE_PROVIDER_BASE_URL=
TMDB_API_KEY=
