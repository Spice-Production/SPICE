{
  "name": "@spice/mobile-expo",
  "version": "0.1.0",
  "private": true,
  "description": "React Native (Expo) rewrite of the SPICE Android client.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --platform android --no-install",
    "android:debug": "node scripts/build-android.mjs debug",
    "android:release": "node scripts/build-android.mjs release",
    "android:engine:test": "node scripts/build-android.mjs engine-test",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --test \"src/core/__tests__/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "124.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
